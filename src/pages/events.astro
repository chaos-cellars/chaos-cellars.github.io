---
import Layout from '../layouts/Layout.astro';
import { getUpcomingEvents, dateParts, timeLabel, calendarSubscribeUrl, SITE_TZ } from '../lib/events';

const events = await getUpcomingEvents();
const subscribeUrl = calendarSubscribeUrl();

// The next three events get banners at the top; the calendar below holds everything.
const BANNER_COUNT = 3;
const banners = events.slice(0, BANNER_COUNT);
const nextId = events[0]?.id;

// Calendar data: one entry per event, with the local (site time zone) days it covers.
const dayKey = (d: Date) =>
  new Intl.DateTimeFormat('en-CA', { timeZone: SITE_TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
const calendarData = events.map((e) => {
  const days: string[] = [];
  const start = new Date(e.start);
  const end = new Date(e.end);
  // All-day ends are exclusive; timed events count the day they end on.
  const last = e.allDay ? new Date(end.getTime() - 1) : end;
  for (let t = start.getTime(); dayKey(new Date(t)) <= dayKey(last) && days.length < 31; t += 864e5) {
    days.push(dayKey(new Date(t)));
  }
  if (!days.length) days.push(dayKey(start));
  const date = dateParts(e);
  return {
    id: e.id,
    title: e.title,
    days,
    end: e.end,
    weekday: date.weekday,
    shortMonth: date.shortMonth,
    day: date.day,
    time: timeLabel(e),
    venue: e.venue,
    address: e.address,
    mapsUrl: e.mapsUrl,
    ticketUrl: e.ticketUrl,
    soldOut: e.soldOut,
    ics: `/events/${e.id}.ics`,
  };
});
---
<Layout title="Events" description="Upcoming tastings and events featuring Chaos Cellars wines in the Finger Lakes and Western New York.">

  <div class="page-header">
    <span class="eyebrow">Mark Your Calendar</span>
    <h1>Events</h1>
    <p>Come taste with us. We pour at shops, festivals and dinners across the region.</p>
  </div>

  <section class="section">
    <div class="container">

      <div class="events-upcoming" id="eventsUpcoming" hidden={events.length === 0}>
        <h2 class="section-label">Coming up</h2>
        <div class="events-list">
          {banners.map((event) => {
            const date = dateParts(event);
            const where = [event.venue, event.address].filter(Boolean).join(' — ');
            return (
              <article
                class:list={['event-card', { 'is-next': event.id === nextId, 'is-sold-out': event.soldOut }]}
                data-end={event.end}
              >
                <div class="event-date-col">
                  <span class="ev-month">{date.shortMonth}</span>
                  <span class="ev-day">{date.day}</span>
                  <span class="ev-weekday-short">{date.weekday.slice(0, 3)}</span>
                </div>
                <div class="event-body">
                  <span class="next-tag">Next up</span>
                  <p class="event-meta">
                    <span class="ev-weekday">{date.weekday}</span>
                    <span class="ev-time">{timeLabel(event)}</span>
                  </p>
                  <h3 class="ev-title">{event.title}</h3>
                  {where && (
                    <p class="ev-location">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M6 1C4.07 1 2.5 2.57 2.5 4.5c0 2.625 3.5 6.5 3.5 6.5s3.5-3.875 3.5-6.5C9.5 2.57 7.93 1 6 1zm0 4.75a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z" fill="currentColor"/>
                      </svg>
                      {where}
                    </p>
                  )}
                  {event.description.length > 0 && (
                    <div class="ev-desc">
                      {event.description.map((p) => <p>{p}</p>)}
                    </div>
                  )}
                  <div class="ev-actions">
                    {event.soldOut ? (
                      <span class="badge-sold-out">Sold Out</span>
                    ) : event.ticketUrl ? (
                      <a href={event.ticketUrl} class="btn btn-primary" target="_blank" rel="noopener">Get Tickets</a>
                    ) : null}
                    {where && (
                      <a href={event.mapsUrl} class="btn btn-ghost" target="_blank" rel="noopener">Directions</a>
                    )}
                    <a href={`/events/${event.id}.ics`} class="btn btn-ghost">Add to Calendar</a>
                    {event.instagramUrl && (
                      <a href={event.instagramUrl} class="text-link" target="_blank" rel="noopener">Instagram</a>
                    )}
                    {event.moreUrl && (
                      <a href={event.moreUrl} class="text-link" target="_blank" rel="noopener">More info</a>
                    )}
                    {event.flyer && (
                      <button type="button" class="text-link flyer-btn" data-flyer={event.flyer} data-title={event.title}>View flyer</button>
                    )}
                  </div>
                </div>
                {event.flyer && (
                  <button type="button" class="flyer-thumb-btn" data-flyer={event.flyer} data-title={event.title} aria-label={`View flyer for ${event.title}`}>
                    <img src={event.flyer} alt="" class="flyer-thumb" loading="lazy" />
                  </button>
                )}
              </article>
            );
          })}
        </div>
      </div>

      <div class="events-calendar" id="eventsCalendar" hidden={events.length === 0}>
        <div class="cal-head">
          <h2 class="section-label">Full calendar</h2>
          <div class="cal-nav">
            <button type="button" class="cal-arrow" id="calPrev" aria-label="Previous month">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg>
            </button>
            <span class="cal-month" id="calMonth" aria-live="polite"></span>
            <button type="button" class="cal-arrow" id="calNext" aria-label="Next month">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>
            </button>
          </div>
        </div>
        <div class="cal-grid" id="calGrid" role="grid" aria-label="Events calendar"></div>
        <ol class="cal-agenda" id="calAgenda"></ol>
        <script is:inline type="application/json" id="calData" set:html={JSON.stringify(calendarData).replace(/</g, '\\u003c')}></script>
      </div>

      <div class="events-empty" id="eventsEmpty" hidden={events.length > 0}>
        <h2>Nothing on the calendar just yet.</h2>
        <p>New dates are added all the time. In the meantime, our wines are on the shelf at a handful of great shops.</p>
        <div class="empty-actions">
          <a href="/partners" class="btn btn-primary">Find a Bottle</a>
          <a href="/#signup" class="btn btn-ghost">Get Event Emails</a>
        </div>
      </div>

      <aside class="stay-in-loop">
        <div>
          <h2>Never miss a pour.</h2>
          <p>Add our events to your own calendar and they'll update automatically, or join the list and we'll tell you when new dates open up.</p>
        </div>
        <div class="loop-actions">
          {subscribeUrl && <a href={subscribeUrl} class="btn btn-ghost" target="_blank" rel="noopener">Follow Our Calendar</a>}
          <a href="/#signup" class="btn btn-ghost">Join the List</a>
          <a href="/partners" class="text-link">Can't make it? Find a bottle near you →</a>
        </div>
      </aside>
    </div>
  </section>

  <dialog class="flyer-dialog" id="flyerDialog" aria-label="Event flyer">
    <button class="flyer-close" id="flyerClose" aria-label="Close flyer">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <img class="flyer-dialog-img" id="flyerDialogImg" src="" alt="" />
  </dialog>

</Layout>

<script>
  // The site rebuilds hourly, but hide anything that has ended since the last build.
  function pruneEnded() {
    const now = Date.now();
    document.querySelectorAll<HTMLElement>('.event-card[data-end]').forEach((card) => {
      if (Date.parse(card.dataset.end ?? '') <= now) card.remove();
    });
    const cards = document.querySelectorAll('.event-card');
    cards.forEach((c, i) => c.classList.toggle('is-next', i === 0));
  }
  pruneEnded();

  // ── Interactive month calendar ──
  type CalEvent = {
    id: string; title: string; days: string[]; end: string; weekday: string; shortMonth: string; day: number;
    time: string; venue: string; address: string; mapsUrl: string; ticketUrl: string | null; soldOut: boolean; ics: string;
  };
  const raw = document.getElementById('calData')?.textContent ?? '[]';
  const calEvents: CalEvent[] = (JSON.parse(raw) as CalEvent[]).filter((e) => Date.parse(e.end) > Date.now());

  const upcoming = document.getElementById('eventsUpcoming');
  const calendar = document.getElementById('eventsCalendar');
  const empty = document.getElementById('eventsEmpty');
  if (upcoming) upcoming.hidden = calEvents.length === 0;
  if (calendar) calendar.hidden = calEvents.length === 0;
  if (empty) empty.hidden = calEvents.length > 0;

  const grid = document.getElementById('calGrid')!;
  const agenda = document.getElementById('calAgenda')!;
  const monthLabel = document.getElementById('calMonth')!;
  const prevBtn = document.getElementById('calPrev') as HTMLButtonElement;
  const nextBtn = document.getElementById('calNext') as HTMLButtonElement;

  const byDay = new Map<string, CalEvent[]>();
  for (const e of calEvents) for (const d of e.days) {
    if (!byDay.has(d)) byDay.set(d, []);
    byDay.get(d)!.push(e);
  }
  const pad = (n: number) => String(n).padStart(2, '0');
  const keyOf = (y: number, m: number, d: number) => `${y}-${pad(m + 1)}-${pad(d)}`;
  const todayKey = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
  const [ty, tm] = todayKey.split('-').map(Number);
  const firstKey = calEvents[0]?.days[0] ?? todayKey;
  const lastKey = calEvents.reduce((k, e) => (e.days[e.days.length - 1] > k ? e.days[e.days.length - 1] : k), todayKey);
  const minIdx = ty * 12 + (tm - 1);
  const maxIdx = Number(lastKey.slice(0, 4)) * 12 + Number(lastKey.slice(5, 7)) - 1;
  let viewIdx = Number(firstKey.slice(0, 4)) * 12 + Number(firstKey.slice(5, 7)) - 1;
  let selected: string | null = null;

  const esc = (t: string) => t.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

  function render() {
    const y = Math.floor(viewIdx / 12), m = viewIdx % 12;
    monthLabel.textContent = new Date(Date.UTC(y, m, 15)).toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
    prevBtn.disabled = viewIdx <= minIdx;
    nextBtn.disabled = viewIdx >= maxIdx;

    const firstDow = new Date(Date.UTC(y, m, 1)).getUTCDay();
    const daysIn = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
    let html = WEEKDAYS.map((w) => `<div class="cal-dow" role="columnheader">${w}</div>`).join('');
    for (let i = 0; i < firstDow; i++) html += '<div class="cal-cell is-blank" aria-hidden="true"></div>';
    for (let d = 1; d <= daysIn; d++) {
      const k = keyOf(y, m, d);
      const evs = byDay.get(k) ?? [];
      const cls = ['cal-cell', evs.length ? 'has-events' : '', k === todayKey ? 'is-today' : '', k < todayKey ? 'is-past' : '', k === selected ? 'is-selected' : ''].filter(Boolean).join(' ');
      const chips = evs.map((e) => `<span class="cal-chip${e.soldOut ? ' is-sold-out' : ''}" title="${esc(e.title)}">${esc(e.title)}</span>`).join('');
      const label = `${d} ${monthLabel.textContent}${evs.length ? `: ${evs.map((e) => e.title).join(', ')}` : ''}`;
      html += evs.length
        ? `<button type="button" class="${cls}" data-day="${k}" aria-label="${esc(label)}" aria-pressed="${k === selected}"><span class="cal-num">${d}</span><span class="cal-chips">${chips}</span><span class="cal-dots" aria-hidden="true">${evs.map(() => '<i></i>').join('')}</span></button>`
        : `<div class="${cls}"><span class="cal-num">${d}</span></div>`;
    }
    const trailing = (7 - ((firstDow + daysIn) % 7)) % 7;
    for (let i = 0; i < trailing; i++) html += '<div class="cal-cell is-blank" aria-hidden="true"></div>';
    grid.innerHTML = html;

    const monthPrefix = `${y}-${pad(m + 1)}`;
    const monthEvents = calEvents.filter((e) => e.days.some((d) => d.startsWith(monthPrefix)));
    agenda.innerHTML = monthEvents.length
      ? monthEvents.map((e) => {
          const where = [e.venue, e.address].filter(Boolean).join(' — ');
          const on = selected !== null && e.days.includes(selected);
          return `<li class="cal-item${on ? ' is-selected' : ''}" data-days="${e.days.join(' ')}">
            <div class="cal-item-date"><span>${e.shortMonth}</span><strong>${e.day}</strong></div>
            <div class="cal-item-body">
              <p class="cal-item-meta">${esc(e.weekday)} · ${esc(e.time)}${e.soldOut ? ' · Sold out' : ''}</p>
              <h3>${esc(e.title)}</h3>
              ${where ? `<p class="cal-item-where">${esc(where)}</p>` : ''}
              <p class="cal-item-links">
                ${e.ticketUrl && !e.soldOut ? `<a href="${esc(e.ticketUrl)}" target="_blank" rel="noopener">Tickets</a>` : ''}
                ${where ? `<a href="${esc(e.mapsUrl)}" target="_blank" rel="noopener">Directions</a>` : ''}
                <a href="${esc(e.ics)}">Add to calendar</a>
              </p>
            </div>
          </li>`;
        }).join('')
      : '<li class="cal-none">No events this month.</li>';
  }

  grid.addEventListener('click', (ev) => {
    const cell = (ev.target as HTMLElement).closest<HTMLElement>('[data-day]');
    if (!cell) return;
    const k = cell.dataset.day!;
    selected = selected === k ? null : k;
    render();
    if (selected) agenda.querySelector('.cal-item.is-selected')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
  prevBtn.addEventListener('click', () => { if (viewIdx > minIdx) { viewIdx--; selected = null; render(); } });
  nextBtn.addEventListener('click', () => { if (viewIdx < maxIdx) { viewIdx++; selected = null; render(); } });
  if (calEvents.length) render();

  const dialog = document.getElementById('flyerDialog') as HTMLDialogElement;
  const img = document.getElementById('flyerDialogImg') as HTMLImageElement;

  document.getElementById('flyerClose')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => { document.body.style.overflow = ''; });

  document.querySelectorAll<HTMLElement>('[data-flyer]').forEach((btn) => {
    btn.addEventListener('click', () => {
      img.src = btn.dataset.flyer ?? '';
      img.alt = `${btn.dataset.title ?? 'Event'} flyer`;
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    });
  });
</script>

<style>
  .events-list {
    display: flex;
    flex-direction: column;
    gap: 1.5px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .event-card {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    background: var(--surface);
    transition: background 0.2s;
  }
  .event-card:hover { background: var(--surface-2); }
  .event-card.is-sold-out { opacity: 0.6; }

  .event-date-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 0.75rem;
    border-right: 1px solid var(--border);
    text-align: center;
  }
  .ev-month, .ev-weekday-short {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    font-weight: 500;
    text-transform: uppercase;
  }
  .ev-month { color: var(--green-mid); }
  .ev-weekday-short { color: var(--muted); margin-top: 0.2rem; }
  .ev-day {
    font-family: var(--font-serif);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--text-bright);
  }

  .event-body { padding: 1.5rem 2rem; min-width: 0; }
  .next-tag { display: none; }
  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-bottom: 0.4rem;
    align-items: center;
  }
  .ev-weekday {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ev-time { font-size: 0.8rem; color: var(--wine); font-weight: 500; }
  .ev-title { font-size: clamp(1.3rem, 2.6vw, 1.6rem); margin-bottom: 0.4rem; }
  .ev-location {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .ev-location svg { margin-top: 0.3rem; flex-shrink: 0; }
  .ev-desc {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--text);
    line-height: 1.6;
    max-width: 600px;
    margin-bottom: 1.1rem;
  }
  .ev-desc p + p { margin-top: 0.5rem; }

  .ev-actions {
    display: flex;
    gap: 0.6rem 1rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .ev-actions .btn { padding: 0.65rem 1.2rem; font-size: 0.7rem; }
  .text-link {
    background: none;
    border: none;
    border-bottom: 1px solid var(--border);
    padding: 0 0 1px;
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .text-link:hover { color: var(--text-bright); border-color: var(--text-bright); }
  .badge-sold-out {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border: 1px solid var(--muted);
    color: var(--muted);
    padding: 0.65rem 1.2rem;
  }

  /* ── The very next event gets the spotlight ── */
  .event-card.is-next { background: var(--surface-2); }
  .event-card.is-next .event-date-col { background: var(--green-dark); border-right-color: var(--green-dark); }
  .event-card.is-next .ev-month,
  .event-card.is-next .ev-weekday-short { color: var(--green-light); }
  .event-card.is-next .ev-day { color: var(--black); font-size: 3.4rem; }
  .event-card.is-next .event-body { padding: 2rem 2.25rem; }
  .event-card.is-next .next-tag {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--wine);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .event-card.is-next .ev-title { font-size: clamp(1.7rem, 3.6vw, 2.3rem); }
  .event-card.is-next .ev-actions .btn { padding: 0.8rem 1.6rem; font-size: 0.74rem; }

  /* ── Flyer ── */
  .flyer-thumb-btn {
    width: 140px;
    background: none;
    border: none;
    border-left: 1px solid var(--border);
    padding: 0;
    cursor: zoom-in;
    overflow: hidden;
  }
  .event-card.is-next .flyer-thumb-btn { width: 200px; }
  .flyer-thumb { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .flyer-thumb-btn:hover .flyer-thumb { transform: scale(1.05); }
  .flyer-btn { display: none; }

  .flyer-dialog { border: none; background: transparent; padding: 0; max-width: 90vw; max-height: 92vh; outline: none; margin: auto; }
  .flyer-dialog::backdrop { background: rgba(26, 20, 10, 0.82); backdrop-filter: blur(4px); }
  .flyer-dialog-img { max-width: 90vw; max-height: 88vh; object-fit: contain; box-shadow: 0 24px 80px rgba(0,0,0,0.5); }
  .flyer-close {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    background: rgba(245, 241, 232, 0.15);
    border: 1px solid rgba(245, 241, 232, 0.3);
    color: #fdf8f2;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
  }


  /* ── Section labels ── */
  .section-label {
    font-size: 0.75rem;
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-mid);
  }
  .events-upcoming > .section-label {
    padding-bottom: 0.85rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .events-upcoming[hidden], .events-calendar[hidden] { display: none; }

  /* ── Empty + footer panels ── */
  .events-empty {
    border: 1px solid var(--border);
    background: var(--surface);
    padding: clamp(2rem, 6vw, 4rem);
    text-align: center;
  }
  .events-empty[hidden] { display: none; }
  .events-empty h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 0.75rem; }
  .events-empty p { font-family: var(--font-serif); font-size: 1.1rem; color: var(--muted); max-width: 460px; margin: 0 auto 2rem; }
  .empty-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }

  .stay-in-loop {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .stay-in-loop h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.5rem; }
  .stay-in-loop p { font-family: var(--font-serif); font-size: 1.05rem; color: var(--muted); max-width: 460px; }
  .loop-actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; align-items: center; justify-content: flex-end; }
  .loop-actions .text-link { flex-basis: 100%; text-align: right; border: none; }

  @media (max-width: 700px) {
    .event-card { grid-template-columns: 4.25rem 1fr; }
    .flyer-thumb-btn { display: none; }
    .flyer-btn { display: inline; }
    .event-date-col { padding: 1.25rem 0.5rem; }
    .ev-day { font-size: 2rem; }
    .event-card.is-next .ev-day { font-size: 2.4rem; }
    .event-body, .event-card.is-next .event-body { padding: 1.25rem 1.1rem; }
    .ev-actions { gap: 0.5rem 0.75rem; }
    .ev-actions .btn, .event-card.is-next .ev-actions .btn { padding: 0.6rem 0.8rem; font-size: 0.66rem; letter-spacing: 0.1em; }
    .stay-in-loop { grid-template-columns: 1fr; }
    .loop-actions { justify-content: flex-start; }
    .loop-actions .text-link { text-align: left; }
  }
</style>

<style is:global>
  /* ── Calendar ── */
  .events-calendar { margin-top: 4rem; }
  .events-calendar .cal-head {
    display: flex;
