---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About" description="Chaos Cellars is a boutique winery dedicated to natural practices and small-lot production in the Finger Lakes, NY. Winemaker Will Jenkins.">

  <div class="page-header">
    <span class="eyebrow">Our Story</span>
    <h1>About Chaos Cellars</h1>
    <p>Wine rooted in tradition and inspired by curiosity.</p>
  </div>

  <!-- Mission -->
  <section class="section">
    <div class="container">
      <div class="mission-grid">
        <div class="mission-text">
          <p class="lede">Chaos Cellars is a boutique winery dedicated to natural practices and small-lot production. Our mission is to make wine rooted in tradition and inspired by curiosity.</p>
          <p>Will Jenkins is a graduate of Finger Lakes Community College's Viticulture and Wine Technology program. His winemaking experience spans the Finger Lakes, Napa Valley, Sonoma, and Oregon's Willamette Valley. Chaos Cellars is Will's passion project — a place where he can apply everything he's learned while experimenting with new ideas in what excites him most.</p>
        </div>
        <div class="mission-img-wrap">
          <img src="/History/WillVineyard.jpg" alt="Will Jenkins in the vineyard" class="mission-img" />
        </div>
      </div>
    </div>
  </section>

  <!-- The Journey -->
  <section class="journey-section">
    <div class="container">
      <div class="journey-head">
        <span class="eyebrow-label">The Winemaker's Journey</span>
        <h2>From the Vine to Home</h2>
      </div>
      <div class="timeline">

        <article class="timeline-stop">
          <div class="timeline-img-wrap">
            <img src="/History/KnightsValley.jpg" alt="Knight's Valley vineyards, Napa" />
            <span class="timeline-badge">2023</span>
          </div>
          <div class="timeline-body">
            <h3>Napa Valley</h3>
            <p class="timeline-sub">Knight's Valley</p>
            <p>Harvest internship working ultra-premium Cabernet Sauvignon, Pinot Noir, and Chardonnay.</p>
          </div>
        </article>

        <article class="timeline-stop">
          <div class="timeline-img-wrap">
            <img src="/History/RussianRiver.jpg" alt="Russian River Valley at sunrise, Sonoma" />
            <span class="timeline-badge">2024</span>
          </div>
          <div class="timeline-body">
            <h3>Sonoma Coast</h3>
            <p class="timeline-sub">Russian River Valley</p>
            <p>Pinot Noir in the remote redwood forest.</p>
          </div>
        </article>

        <article class="timeline-stop">
          <div class="timeline-img-wrap">
            <img src="/History/WillametteValley.jpg" alt="Willamette Valley with Mount Hood, Oregon" />
            <span class="timeline-badge">2025</span>
          </div>
          <div class="timeline-body">
            <h3>Oregon</h3>
            <p class="timeline-sub">Willamette Valley</p>
            <p>Pacific Northwest Rieslings and other varietals.</p>
          </div>
        </article>

        <article class="timeline-stop timeline-stop--home">
          <div class="timeline-img-wrap">
            <img src="/History/MAIN-Keuka-Lake-NY-Photo-by-antsdrone-Shutterstock-1024x576-2968622363.jpeg" alt="Keuka Lake, Finger Lakes, NY" />
            <span class="timeline-badge timeline-badge--home">Home</span>
          </div>
          <div class="timeline-body">
            <h3>The Finger Lakes</h3>
            <p class="timeline-sub">New York</p>
            <p>Returning to the Finger Lakes to bring out the very best of the region.</p>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section">
    <div class="container">
      <div class="divider"></div>
      <div class="contact-section">
        <div class="contact-header">
          <h2>Get In Touch</h2>
          <p class="contact-intro">We're a small, itinerant operation with no permanent tasting room. The best way to find our wine is through our distribution partners and winemaker tasting events — and the best way to reach us is directly.</p>
        </div>
        <div class="contact-layout">

          <div class="contact-info">
            <div class="contact-item">
              <h3>Email</h3>
              <p><a href="mailto:chaos-cellars@outlook.com">chaos-cellars@outlook.com</a></p>
            </div>
            <div class="contact-item">
              <h3>Follow Along</h3>
              <div class="social-stack">
                <a href="https://instagram.com/chaoscellars" target="_blank" rel="noopener" class="social-row">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5"/>
                    <circle cx="12" cy="12" r="4"/>
                    <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
                  </svg>
                  <span>@chaoscellars on Instagram</span>
                </a>
                <a href="https://facebook.com/chaoscellars" target="_blank" rel="noopener" class="social-row">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                  </svg>
                  <span>@chaoscellars on Facebook</span>
                </a>
              </div>
            </div>
            <div class="contact-item">
              <h3>Find Our Wine</h3>
              <p>Our wines are available at select shops, bars, and restaurants throughout New York. <a href="/partners">See all partners →</a></p>
            </div>
            <div class="contact-item">
              <h3>Meet the Winemaker</h3>
              <p>Will pours at winemaker tastings and pop-up events throughout the year. <a href="/events">See upcoming events →</a></p>
            </div>
          </div>

          <div class="contact-form-wrap">
            <h3 class="form-heading">Send a Message</h3>
            <!-- To activate: sign up at formspree.io, create a form pointing to chaos-cellars@outlook.com, and replace YOUR_FORM_ID below -->
            <form class="contact-form" action="https://formspree.io/f/meewwwja" method="POST">
              <input type="hidden" name="_subject" value="New message from chaoscellars.com" />
              <div class="form-group">
                <label for="contact-name">Name</label>
                <input type="text" id="contact-name" name="name" required placeholder="Your name" />
              </div>
              <div class="form-group">
                <label for="contact-email">Email</label>
                <input type="email" id="contact-email" name="email" required placeholder="your@email.com" />
              </div>
              <div class="form-group">
                <label for="contact-inquiry">Inquiry</label>
                <textarea id="contact-inquiry" name="inquiry" rows="5" required placeholder="How can we help?"></textarea>
              </div>
              <button type="submit" class="btn btn-primary">Send Message</button>
            </form>
          </div>

        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Mission ── */
  .mission-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: start;
  }
  .mission-text p {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }
  .mission-text p:last-child { margin-bottom: 0; }
  .lede {
    font-size: 1.3rem !important;
    color: var(--text) !important;
  }
  .mission-img-wrap {
    position: sticky;
    top: 6rem;
  }
  .mission-img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: top center;
    border: 1px solid var(--border);
  }

  /* ── Journey / Timeline ── */
  .journey-section {
    background: var(--deep);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 5vw, 3rem);
  }
  .journey-head {
    margin-bottom: 3rem;
  }
  .journey-head h2 {
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .eyebrow-label {
    font-size: 0.72rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--green-mid);
    display: block;
    margin-bottom: 0.75rem;
  }

  .timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .timeline-stop {
    background: var(--surface);
    display: flex;
    flex-direction: column;
    transition: background 0.2s;
  }
  .timeline-stop:hover { background: var(--surface-2); }

  .timeline-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
  }
  .timeline-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .timeline-stop:hover .timeline-img-wrap img {
    transform: scale(1.04);
  }
  .timeline-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--green-dark);
    color: #fdf8f2;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 300;
    padding: 0.2rem 0.65rem;
    letter-spacing: 0.05em;
  }
  .timeline-badge--home {
    background: var(--wine);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .timeline-body {
    padding: 1.5rem;
    flex: 1;
  }
  .timeline-body h3 {
    font-size: 1.25rem;
    margin-bottom: 0.2rem;
  }
  .timeline-sub {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-mid);
    margin-bottom: 0.75rem;
    display: block;
  }
  .timeline-body p:not(.timeline-sub) {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    color: var(--muted);
    line-height: 1.65;
  }
  .timeline-stop--home .timeline-body h3 {
    color: var(--wine);
  }

  /* ── Divider ── */
  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0 0 4rem;
  }

  /* ── Contact ── */
  .contact-header { margin-bottom: 3rem; }
  .contact-header h2 { font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 0.75rem; }
  .contact-intro {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 640px;
    line-height: 1.65;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-info { display: flex; flex-direction: column; }
  .contact-item {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .contact-item:first-child { border-top: 1px solid var(--border); }
  .contact-item h3 {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--green-mid);
    font-family: var(--font-sans);
    font-weight: 500;
    margin-bottom: 0.6rem;
  }
  .contact-item p {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.55;
  }
  .contact-item a { color: var(--green-dark); transition: opacity 0.2s; }
  .contact-item a:hover { opacity: 0.7; }

  .social-stack { display: flex; flex-direction: column; gap: 0.6rem; }
  .social-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--green-dark);
    transition: opacity 0.2s;
  }
  .social-row:hover { opacity: 0.7; }
  .social-row svg { flex-shrink: 0; }

  /* ── Contact Form ── */
  .contact-form-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 2.5rem;
  }
  .form-heading {
    font-size: 1.6rem;
    margin-bottom: 2rem;
    color: var(--text-bright);
  }
  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-mid);
    font-family: var(--font-sans);
    font-weight: 500;
  }
  .form-group input,
  .form-group textarea {
    background: var(--black);
    border: 1px solid var(--border);
    color: var(--text-bright);
    padding: 0.8rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
    resize: vertical;
  }
  .form-group input::placeholder,
  .form-group textarea::placeholder { color: var(--muted); }
  .form-group input:focus,
  .form-group textarea:focus { border-color: var(--wine); }
  .contact-form .btn { align-self: flex-start; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .timeline { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 800px) {
    .contact-layout { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 720px) {
    .mission-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .mission-img-wrap { position: static; }
    .mission-img { aspect-ratio: 16/9; object-position: center; }
  }
  @media (max-width: 560px) {
    .timeline { grid-template-columns: 1fr; }
  }
</style>
